/* ==========================================
   BEE STRATEGY HUD
   Fairy-tale honeycomb theme (Procedural Feel)
   ========================================== */

.root {
    flex-grow: 1;
    justify-content: space-between;
}

/* ==========================================
   TOP: Resource Bar
   ========================================== */
.top-container {
    align-items: center;
    padding-top: 10px;
}

.resource-bar {
    flex-direction: row;
    align-items: center;
    /* Simulated honey/amber gradient */
    background-color: #8B6914;
    border-radius: 20px;
    border-top-width: 2px;
    border-bottom-width: 4px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #553B0B;
    padding: 7px 22px;
}

.resource-bar > * {
    margin-right: 2px;
}

.res-item {
    flex-direction: row;
    align-items: center;
    padding: 0 6px;
}

.res-.law-check {
    color: #5D4037;
    font-size: 14px;
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.panel-separator {
    height: 1px;
    background-color: #D7CCC8;
    margin-top: 5px;
    margin-bottom: 10px;
}

.regime-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 5px;
}

.regime-value {
    color: #C62828;
    -unity-font-style: bold;
    font-size: 14px;
}

.res-label {
    color: #FFE8A0;
    font-size: 13px;
    margin-right: 5px;
    -unity-font-style: bold;
}

.res-value {
    color: #FFFDE7;
    font-size: 15px;
    -unity-font-style: bold;
    margin-right: 3px;
}

.res-value.dandelion { color: #FFF176; }
.res-value.tulip { color: #F48FB1; }
.res-value.sunflower { color: #FFB74D; }
.res-value.bees { color: #FFD54F; font-size: 16px; }

.res-divider {
    color: rgba(255, 232, 160, 0.3);
    font-size: 16px;
    margin: 0 4px;
}

/* ==========================================
   SPACER
   ========================================== */
.spacer {
    flex-grow: 1;
}

/* ==========================================
   POPUP PANELS
   ========================================== */
.panels-container {
    align-items: center;
    padding-bottom: 4px;
}

.popup-panel {
    width: 290px;
    background-color: #FFF8E1;
    border-radius: 12px;
    border-top-width: 2px;
    border-bottom-width: 4px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #8B6914;
    margin-bottom: 6px;
}

.panel-title {
    color: #4E342E;
    font-size: 16px;
    -unity-font-style: bold;
    padding: 10px 14px 8px 14px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(139, 105, 20, 0.3);
    background-color: rgba(255, 213, 79, 0.3);
    border-top-left-radius: 9px;
    border-top-right-radius: 9px;
}

.panel-body {
    padding: 10px 14px 12px 14px;
}

.panel-arrow {
    width: 18px;
    height: 18px;
    background-color: #FFF8E1;
    border-right-width: 4px;
    border-bottom-width: 4px;
    border-color: #8B6914;
    rotate: 45deg;
    align-self: center;
    margin-top: -12px;
    margin-bottom: -6px;
}

.panel-separator {
    height: 2px;
    background-color: rgba(139, 105, 20, 0.15);
    margin: 10px 0;
    border-radius: 1px;
}

.panel-status {
    color: #558B2F;
    font-size: 12px;
    -unity-font-style: italic;
    margin-top: 4px;
    -unity-text-align: middle-center;
}

/* ==========================================
   Build Panel
   ========================================== */
.build-option {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 6px 0;
}

.build-name {
    color: #4E342E;
    font-size: 14px;
    -unity-font-style: bold;
}

.build-cost {
    color: #8D6E63;
    font-size: 12px;
    margin-right: 8px;
}

.btn-place {
    background-color: #E8A817;
    color: #3E2723;
    border-radius: 8px;
    border-top-width: 1px;
    border-bottom-width: 3px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #A67C00;
    padding: 6px 18px;
    font-size: 13px;
    -unity-font-style: bold;
}

.btn-place:hover {
    background-color: #F0C040;
}

.btn-place:active {
    background-color: #C8960C;
    border-bottom-width: 1px; /* Press effect */
    border-top-width: 3px;
}

.btn-place.active {
    background-color: #D32F2F;
    border-color: #B71C1C;
    color: white;
}

/* ==========================================
   Workers Panel
   ========================================== */
.worker-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 0;
}

.w-name {
    color: #5D4037;
    font-size: 13px;
}

.w-count {
    color: #4E342E;
    font-size: 14px;
    -unity-font-style: bold;
    min-width: 30px;
    -unity-text-align: middle-right;
}

.subsection-title {
    color: #795548;
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    margin-top: 4px;
}

.honey-slider {
    margin: 6px 0;
}

.honey-slider .unity-base-slider__dragger {
    background-color: #E8A817;
    border-radius: 10px;
    border-top-width: 1px;
    border-bottom-width: 3px;
    border-color: #A67C00;
    width: 18px;
    height: 18px;
}

.honey-slider .unity-base-slider__tracker {
    background-color: rgba(166, 124, 0, 0.25);
    border-radius: 4px;
    height: 8px;
}

.ratio-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.ratio-text {
    color: #8D6E63;
    font-size: 12px;
}

/* ==========================================
   Laws Panel
   ========================================== */
.law-item {
    flex-direction: row;
    align-items: center;
    padding: 4px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(166, 124, 0, 0.1);
}

.law-item.disabled {
    opacity: 0.5;
}

.law-check {
    margin-right: 8px;
}

.law-text {
    color: #4E342E;
    font-size: 12px;
}

.regime-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 0;
}

.regime-value {
    color: #E65100;
    font-size: 13px;
    -unity-font-style: bold;
}

/* ==========================================
   SELECTED HIVE PANEL
   ========================================== */
.selected-panel {
    position: absolute;
    right: 20px;
    top: 60px; /* Below resource bar */
    width: 250px;
}

.sh-info-text {
    color: #5D4037;
    font-size: 13px;
    -unity-font-style: bold;
}

.sh-action-btn {
    background-color: #FFB300;
    border-width: 0;
    border-radius: 8px;
    color: #5D4037;
    -unity-font-style: bold;
    font-size: 13px;
    padding: 5px 10px;
    margin-top: 5px;
    margin-bottom: 5px;
    border-bottom-width: 3px;
    border-bottom-color: #F57F17;
}

.sh-action-btn:hover {
    background-color: #FFCA28;
}

.sh-action-btn:active {
    border-bottom-width: 0;
    margin-top: 8px;
    margin-bottom: 2px;
}

.sh-action-btn:disabled {
    background-color: #BCAAA4;
    border-bottom-color: #8D6E63;
    color: #795548;
}

/* ==========================================
   Coming Soon
   ========================================== */
.coming-soon {
    color: #A1887F;
    font-size: 11px;
    -unity-font-style: italic;
    -unity-text-align: middle-center;
    margin-top: 8px;
    padding: 6px;
    background-color: rgba(166, 124, 0, 0.08);
    border-radius: 8px;
}

/* ==========================================
   BOTTOM: Toolbar (Simulated Wood)
   ========================================== */
.toolbar-container {
    align-items: center;
    padding-bottom: 16px;
}

.toolbar {
    flex-direction: row;
    background-color: #5D4037; /* Warm Wood */
    border-radius: 20px;
    padding: 6px 10px;
    border-top-width: 2px;
    border-bottom-width: 5px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #3E2723;
}

.toolbar-btn {
    background-color: #D4A017;
    color: #3E2723;
    border-radius: 16px;
    border-top-width: 1px;
    border-bottom-width: 4px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-color: #8B6914;
    padding: 8px 22px;
    margin: 0 4px;
    font-size: 14px;
    -unity-font-style: bold;
}

.toolbar-btn:hover {
    background-color: #E8B828;
    border-color: #A67C00;
}

.toolbar-btn:active {
    background-color: #B8860B;
    border-bottom-width: 1px; /* Press effect */
    border-top-width: 4px;
}

.toolbar-btn.selected {
    background-color: #FFD54F;
    border-color: #F9A825;
    border-bottom-width: 1px; /* Press effect */
    border-top-width: 4px;
}

/* ==========================================
   WORLD SPACE UI (Hive Badges)
   ========================================== */
.world-space-container {
    position: absolute;
    left: 0; 
    top: 0; 
    right: 0; 
    bottom: 0;
}

.hive-badge {
    position: absolute;
    background-color: rgba(255, 248, 225, 0.9); /* Cream parchment */
    border-radius: 12px;
    border-top-width: 2px;
    border-bottom-width: 4px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-color: #8B6914;
    padding: 6px;
    align-items: center;
    
    /* Center horizontally, place above the hive vertically */
    translate: -50% -100%;
    margin-top: -30px; 
}

.hive-badge-team {
    color: #FFFFFF;
    border-radius: 8px;
    padding: 2px 10px;
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    border-bottom-width: 2px;
    border-color: rgba(0,0,0,0.2);
}

.hive-badge-stats {
    color: #4E342E;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
