.container {
    background-color: rgba(40, 40, 40, 0.95);
    padding: 15px;
    border-radius: 8px;
    width: 380px;
    margin: 20px;
    border-color: rgb(70, 70, 70);
    border-width: 1px;
}

.controls-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 15px;
}

.input-field {
    flex-grow: 1;
    color: black;
}

.action-btn {
    color: white;
    font-weight: bold;
    margin-left: 8px;
    padding: 6px 12px;
    border-radius: 4px;
    border-width: 0;
}

.add-btn {
    background-color: rgb(76, 175, 80);
}
.add-btn:hover { background-color: rgb(96, 195, 100); }

.remove-btn {
    background-color: rgb(244, 67, 54);
}
.remove-btn:hover { background-color: rgb(255, 87, 74); }

.stats-row {
    flex-direction: row;
    justify-content: space-between;
    background-color: rgba(0, 0, 0, 0.4);
    padding: 8px 12px;
    border-radius: 6px;
}

.stat-label {
    color: rgb(220, 220, 220);
    font-size: 14px;
    font-weight: bold;
}